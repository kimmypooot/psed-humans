APP_NAME="CSC RO VIII HUMANS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8120

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=psed_humans
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="HUMANS"

# Sign-in from the IMIS portal. URL of IMIS POST /api/v1/sso/validate; the
# audience defaults to APP_URL host[:port] and must be in IMIS SSO_HUB_HOSTS.
IMIS_SSO_URL=http://localhost:8000/api/v1/sso/validate
IMIS_SSO_AUDIENCE=
# Where people who reach this system signed out are sent to open it from IMIS.
IMIS_PORTAL_URL=http://localhost:8000
# Sign-in limits, as in IMIS (minutes): idle timeout (SESSION_LIFETIME), absolute cap, warning before either.
SESSION_ABSOLUTE_LIFETIME=480
SESSION_IDLE_WARNING=5

# IMIS's people directory. The token must equal IMIS's CARES_API_TOKEN.
IMIS_API_URL=
IMIS_API_TOKEN=

